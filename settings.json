{
  // =========================
  // Editor Appearance
  // =========================
  "base_keymap": "JetBrains",
  "icon_theme": "JetBrains New UI Icons (Dark)",
  "vim_mode": false,
  "inlay_hints": {
    "show_other_hints": false,
    "show_parameter_hints": false,
    "show_type_hints": true,
    "show_value_hints": true,
  },
  "tab_bar": {
    "show": true,
  },
  "preview_tabs": {
    "enabled": true,
    "enable_preview_from_file_finder": true,
  },
  "active_pane_modifiers": {
    "border_size": 0.0,
    "inactive_opacity": 1.0,
  },
  "ui_font_size": 16,
  "buffer_font_size": null,

  "buffer_font_features": {
    "calt": false, // ligatures
  },
  "lsp_document_colors": "none",
  "wrap_guides": [0],
  "show_edit_predictions": false,

  // Theme & Colors
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "JetBrains Dark",
  },
  "experimental.theme_overrides": {
    "background.appearance": "transparent",
    // "syntax": {
    //   "keyword": { "color": "#9D70FF" },
    //   "function": { "color": "#BCBEC4" },
  },
  // },

  // =========================
  // Editor Behavior
  // =========================
  "autosave": {
    "after_delay": { "milliseconds": 500 },
  },
  "format_on_save": "on",
  "restore_on_startup": null,
  "show_completions_on_input": true,

  // =========================
  // AI & Assistant Features
  // =========================
  "agent": {
    "play_sound_when_agent_done": true,
    "inline_assistant_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4-thinking",
    },
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4",
    },
  },
  "edit_predictions": {
    "mode": "subtle",
    "enabled_in_text_threads": false,
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null,
    },
  },
  "features": {
    "edit_prediction_provider": "zed",
  },

  // =========================
  // Git Integration
  // =========================
  "git": {
    "inline_blame": { "enabled": false },
  },

  // =========================
  // Language-Specific Settings
  // =========================
  "languages": {
    "Python": {
      "language_servers": ["!basedpyright", "ty"],
      "formatter": {
        "external": {
          "command": "/home/ronnyascencio/.local/bin/ruff",
          "arguments": ["format", "--stdin-filename", "{buffer_path}", "-"],
        },
      },
      "format_on_save": "on",
    },
    // Rust
    "Rust": {
      "formatter": {
        "external": {
          "command": "rustfmt",
          "arguments": [],
        },
      },
      "format_on_save": "on",
    },
  },

  // =========================
  // LSP (Language Server Protocol) for Rust
  // =========================
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy", // rust-analyzer.check.command (default: "check")
        },
        "imports": {
          "merge": { "glob": false },
          "granularity": {
            "enforce": true,
            "group": "module",
          },
        },
        "inlayHints": {
          "maxLength": null,
          "lifetimeElisionHints": {
            "enable": "skip_trivial",
            "useParameterNames": true,
          },
          "closureReturnTypeHints": {
            "enable": "always",
          },
        },
      },
    },
  },
  "terminal": {
    "env": {
      "VIRTUAL_ENV": ".venv",
    },
    "copy_on_select": true,
  },

  // =========================
  // Privacy & Telemetry
  // =========================
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
}
